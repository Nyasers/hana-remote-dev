{
  "name": "hana-remote-dev",
  "version": "0.8.11",
  "type": "module",
  "description": "SSH remote development plugin for Hanako",
  "dependencies": {
    "@rspack/cli": "^2.1.9",
    "@rspack/core": "^2.1.9",
    "archiver": "^8.0.0",
    "clean-css": "^5.3.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ssh2": "^1.17.0",
    "terser": "^5.50.0"
  },
  "trustedDependencies": [
    "cpu-features",
    "ssh2"
  ],
  "scripts": {
    "build": "rspack build --config rspack.config.mjs && node src/scripts/copy-native.mjs && node src/scripts/sync-release.mjs",
    "build:watch": "rspack build --config rspack.config.mjs --watch",
    "package": "node scripts/package.mjs",
    "test": "node test/hrd-test.mjs",
    "version": "node scripts/version.mjs",
    "version:sync": "node scripts/version-sync.mjs"
  }
}
